# ==============================================================================
# AMMUNITION & WAREHOUSE COMPLIANCE MANAGEMENT SYSTEM (AWCMS)
# ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVER CONFIGURATION
# ------------------------------------------------------------------------------
PORT=3000
NODE_ENV="development"
APP_URL="http://localhost:3000"
APP_NAME="Ammunition & Warehouse Compliance Management System"
APP_SHORT_NAME="AWCMS"

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# Core storage is SQLite (file-based). For PostgreSQL, set DATABASE_URL to a
# PostgreSQL connection string and ensure the schema is compatible.
# Example (PostgreSQL): DATABASE_URL="postgresql://user:pass@localhost:5432/awcms"
# Example (SQLite):     DATABASE_URL="file:./data/awcms.db"
DATABASE_URL="file:./data/awcms.db"

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & SESSION
# ------------------------------------------------------------------------------
# Generate a strong secret: openssl rand -base64 32
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-strong-random-secret-min-32-chars"
JWT_SECRET="replace-with-a-strong-random-secret-min-32-chars"

# ------------------------------------------------------------------------------
# 4. FILE UPLOAD & STORAGE (LOCAL SECURE STORAGE)
# ------------------------------------------------------------------------------
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE_MB=10
ALLOWED_FILE_TYPES="application/pdf,image/jpeg,image/png,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,text/csv"

# ------------------------------------------------------------------------------
# 5. SECURITY
# ------------------------------------------------------------------------------
# Rate limiting: maximum login attempts per window
LOGIN_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_WINDOW_MS=900000

# ------------------------------------------------------------------------------
# 6. FIRST-TIME ADMIN SETUP (Optional - if not set, setup screen prompts interactively)
# ------------------------------------------------------------------------------
# These are defaults only. In production, use the setup screen to create the
# first admin interactively. Do not hardcode production credentials here.
ADMIN_NAME=""
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_PHONE=""

MANAGER_NAME=""
MANAGER_EMAIL=""
MANAGER_PASSWORD=""
MANAGER_PHONE=""

INSPECTOR_NAME=""
INSPECTOR_EMAIL=""
INSPECTOR_PASSWORD=""
INSPECTOR_PHONE=""

VIEWER_NAME=""
VIEWER_EMAIL=""
VIEWER_PASSWORD=""
VIEWER_PHONE=""

# ------------------------------------------------------------------------------
# 7. DEFAULT WAREHOUSE (Optional)
# ------------------------------------------------------------------------------
DEFAULT_DEPOT_CODE=""
DEFAULT_DEPOT_NAME=""
DEFAULT_DEPOT_CITY=""
DEFAULT_DEPOT_STATE=""
DEFAULT_DEPOT_PIN=""

# ==============================================================================
# VARIABLE USAGE GUIDE
# ==============================================================================
# DATABASE_URL      - Connection string for SQLite (default) or PostgreSQL.
# NEXTAUTH_URL      - Base URL of the application for session cookie domain.
# NEXTAUTH_SECRET   - Secret for signing session tokens (NextAuth compatible).
# JWT_SECRET        - Secret for signing JWT access tokens used by API middleware.
# UPLOAD_DIR        - Local filesystem directory for secure file storage.
# MAX_FILE_SIZE_MB  - Maximum upload file size in megabytes (default 10 MB).
# ALLOWED_FILE_TYPES - Comma-separated MIME types permitted for upload.
# LOGIN_RATE_LIMIT_* - Controls brute-force protection on the login endpoint.
# ADMIN_*           - Credentials for the first administrator (setup screen).
# MANAGER_*         - Credentials for warehouse manager role.
# INSPECTOR_*       - Credentials for technical inspector role.
# VIEWER_*          - Credentials for staff/viewer role.
# DEFAULT_DEPOT_*   - Default warehouse created on first boot if no warehouse exists.
# ==============================================================================
